node_modules/
# Los cuerpos de los prompts no se versionan ni se publican: viven en Supabase.
# Se regeneran con `npm run build:catalog` desde data/prompts.js.
build/

# Fuente de los prompts: local y en Supabase, nunca en un repo público.
# Con el asterisco van también las copias que dejan mejorar-prompts y
# aplicar-v12 (prompts.js.antes-de-…): son el catálogo entero igual.
data/prompts.js
data/prompts.js.*

# Salidas que llevan prompts. Mismo motivo que data/prompts.js: el repo es
# público y su historial ya se purgó una vez por esto.
pedido-v12.txt
respuestas-v12.txt
wallpaperia-panel-*.js

# Salida de scripts/post-gratis.mjs: lleva prompts del catálogo.
post-gratis*.md
